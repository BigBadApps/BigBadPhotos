# BigBadPhotos — Environment Variables
# Copy this to .env and fill in your values. Never commit .env.

## Required for Google OAuth (Drive proxy + Photos upload + autonomous worker)
# GOOGLE_CLIENT_ID=your-client-id-here
# GOOGLE_CLIENT_SECRET=your-client-secret-here

## Optional (generated at startup if unset — set a stable value so sessions
## survive Flask restarts/deploys, e.g. on Railway)
# FLASK_SECRET_KEY=your-random-hex-string

## Optional: path to the Google token store (default: ~/.bigbadphotos/google_token.json)
# BBP_TOKEN_PATH=/custom/path/google_token.json

## Password auth (alternative or supplement to Google OAuth)
# BBP_PASSWORD=your-password-here

## Comma-separated email allowlist for Google OAuth (empty = all rejected)
# BBP_ALLOWED_EMAILS=you@gmail.com,friend@gmail.com

## Debug / dev mode (set to 1 to bypass auth locally)
# FLASK_DEBUG=1
# BBP_DEBUG=1

## Camera Bridge (FTP ingest)
# BBP_FTP_PORT=2121
# BBP_FTP_USER=bbp
# BBP_FTP_PASS=changeme
# BBP_FTP_ROOT=./_ftp_root

## Topaz Photo AI CLI path (auto-detected if omitted)
# TOPAZ_BINARY=/Applications/Topaz Photo AI.app/Contents/MacOS/Topaz Photo AI
